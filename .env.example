# ──────────────────────────────────────────────────────────────
# Kolek — variables de entorno
# Copia este archivo como .env.local y llena los valores.
# ──────────────────────────────────────────────────────────────

# URL pública de la app. En local: http://localhost:3000
# En Vercel: https://tu-dominio.vercel.app  (SIN slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SUPABASE ──────────────────────────────────────────────────
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key: NUNCA la expongas al cliente. Solo se usa en
# route handlers y server components (webhooks, página pública /p/[token]).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── MERCADO PAGO ──────────────────────────────────────────────
# Credenciales de PLATAFORMA (fallback). Cada escuela puede poner
# las suyas en /dashboard/settings y esas tienen prioridad.
# https://www.mercadopago.com.mx/developers/panel/app -> Credenciales
# TEST-... para pruebas, APP_USR-... para producción.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Opcional: firma del webhook (Panel MP > Webhooks > Clave secreta).
# Si está vacío, el webhook igual valida contra la API de MP.
MP_WEBHOOK_SECRET=

# ── WHATSAPP CLOUD API (Meta) ─────────────────────────────────
# https://developers.facebook.com > tu app > WhatsApp > Configuración de la API
# Si dejas WHATSAPP_TOKEN vacío, Kolek guarda los mensajes en la tabla
# whatsapp_logs con status 'en_cola' para envío manual. Nada se pierde.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nombre e idioma del template aprobado en Meta Business Manager
WHATSAPP_TEMPLATE_NAME=kolek_link_pago
WHATSAPP_TEMPLATE_LANG=es_MX
# Token que tú inventas; el mismo que pones en Meta > Webhooks > Verificar token
WHATSAPP_VERIFY_TOKEN=kolek-verify-token
# App Secret de Meta (para validar la firma X-Hub-Signature-256). Opcional.
WHATSAPP_APP_SECRET=

# ── RESEND (emails, opcional) ─────────────────────────────────
# https://resend.com/api-keys — si está vacío, Kolek no manda emails.
RESEND_API_KEY=
RESEND_FROM="Kolek <pagos@tudominio.com>"

# ── CRON (recordatorios automáticos, plan Crecimiento/Pro) ────
# Secreto para proteger /api/cron/reminders. Vercel lo manda como
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio
